rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. Rate Confirmations (RC) uploads
    match /rate_confirmations/{companyId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // 2. Chat attachments and communications files
    match /communications/{companyId}/{loadId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // 3. POD (Proof of Delivery) scanner uploads
    match /admins/{companyId}/loads/{loadId}/pods/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
