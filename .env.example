# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps visualization in Dispatcher view.
# Users configure this via the Secrets panel in the AI Studio UI.
GOOGLE_MAPS_PLATFORM_KEY="AIzaSyDEan8UHwbgHIsbxJv6rODJRZi_KdgE0Ao"

# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER: Optional for sending live SMS text messages to drivers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# STRIPE_SECRET_KEY: Required for live Stripe billing subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_3L04sUgBIJKANNukZi6OzTKWWLyJzfDR
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
# Intuit QuickBooks OAuth Credentials (from Intuit Developer Portal Keys & OAuth)
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI="https://api.tdpro.cloud/api/integrations/quickbooks/callback"

